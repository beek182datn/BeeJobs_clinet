{
  "expo": {
    "name": "BeeJobs_Client",
    "slug": "BeeJobs_Client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "supportsTablet": true,
      "minSdkVersion": 21,
      "targetSdkVersion": 34,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.DATN.BeeJobs_Clinet",
      "permissions": [
    "WRITE_EXTERNAL_STORAGE",
    "READ_EXTERNAL_STORAGE"
  ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-document-picker",
       
        {
          "iCloudContainerEnvironment": "production"
        }
      ],
      "expo-file-system"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
